#!/usr/bin/python3
"""Validate controller-only Ansible Vault inputs before contacting a host."""

import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml

ROOT = Path(os.environ.get("BASTION_ROOT", Path(__file__).resolve().parents[1])).resolve()
REQUIRED = {"admin_authorized_key", "vault_password_file", "vault_secrets_file"}
ED25519_KEY = re.compile(r"ssh-ed25519 [A-Za-z0-9+/=]+(?: [^\r\n]+)?$")
VAULT_FILE = re.compile(r"secrets/[A-Za-z0-9][A-Za-z0-9_.-]*\.yaml")
SERVER_NAMES = {"admin-password-hash", "root-password-hash", "ssh-notify-config"}
VPN_NAMES = {"openvpn-server-key", "openvpn-ca-key", "wireguard-server-key"}


def fail(message: str) -> None:
    raise SystemExit(f"preflight-secrets: {message}")


def vault_document(ciphertext: Path, password: Path) -> dict:
    with tempfile.TemporaryDirectory(prefix="bastion-vault-preflight.") as temporary:
        environment = os.environ | {"ANSIBLE_LOCAL_TEMP": str(Path(temporary) / "ansible")}
        try:
            result = subprocess.run(
                ["ansible-vault", "view", "--vault-password-file", str(password), str(ciphertext)],
                text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=environment,
            )
        except OSError:
            fail("cannot run ansible-vault to validate ciphertext")
    if result.returncode:
        fail("Ansible Vault ciphertext cannot be decrypted with vault_password_file")
    try:
        document = yaml.safe_load(result.stdout)
    except yaml.YAMLError:
        fail("decrypted Ansible Vault data is not YAML")
    if not isinstance(document, dict) or any(not isinstance(value, str) or not value for value in document.values()):
        fail("decrypted Ansible Vault data must be a non-empty string mapping")
    return document


def vault_path(value: object, label: str) -> Path:
    if not isinstance(value, str):
        fail(f"{label} must be a string")
    path = Path(value)
    if not path.is_absolute() or not path.is_file():
        fail(f"{label} must be an existing absolute regular file")
    return path.resolve()


def main() -> None:
    input_path = Path(sys.argv[1]) if len(sys.argv) == 2 else ROOT / "inventory/secrets-input.json"
    try:
        values = json.loads(input_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read JSON input: {error}")
    if not isinstance(values, dict) or set(values) != REQUIRED:
        fail("input must contain exactly the required controller delivery fields")
    if not isinstance(values["admin_authorized_key"], str) or not ED25519_KEY.fullmatch(values["admin_authorized_key"]):
        fail("admin_authorized_key must be an Ed25519 public key")
    password = vault_path(values["vault_password_file"], "vault_password_file")
    configured = os.environ.get("BASTION_VAULT_PASSWORD_FILE")
    if configured and password != Path(configured).resolve():
        fail("vault_password_file must match the Make controller Vault password source")
    ciphertext_value = values["vault_secrets_file"]
    if not isinstance(ciphertext_value, str) or not VAULT_FILE.fullmatch(ciphertext_value):
        fail("vault_secrets_file must be a direct YAML file under secrets/")
    ciphertext = ROOT / ciphertext_value
    if ciphertext.resolve().parent != (ROOT / "secrets").resolve():
        fail("vault_secrets_file must not leave secrets/")
    try:
        payload = ciphertext.read_text(encoding="utf-8")
    except OSError as error:
        fail(f"cannot read Ansible Vault ciphertext: {error}")
    if not payload.startswith("$ANSIBLE_VAULT;"):
        fail("vault_secrets_file must be Ansible Vault ciphertext")
    server = vault_document(ciphertext, password)
    if set(server) != SERVER_NAMES:
        fail("server Vault must contain exactly the password hashes and complete ssh_notify configuration")
    notify = server["ssh-notify-config"]
    for required_line in ("SSHLogFile = /var/log/auth.log", "ServerName = bastion", "TelegramBotToken =", "TelegramNotifyChat ="):
        if required_line not in notify:
            fail("ssh_notify configuration is incomplete")
    vpn_ciphertext = ROOT / "secrets/vpn-server.yaml"
    if not vpn_ciphertext.exists():
        return
    try:
        vpn_payload = vpn_ciphertext.read_text(encoding="utf-8")
    except OSError as error:
        fail(f"cannot read lifecycle VPN Vault ciphertext: {error}")
    if not vpn_payload.startswith("$ANSIBLE_VAULT;"):
        fail("lifecycle VPN data must be Ansible Vault ciphertext")
    if set(vault_document(vpn_ciphertext, password)) != VPN_NAMES:
        fail("lifecycle VPN Vault must contain exactly the server and CA private keys")


if __name__ == "__main__":
    main()
