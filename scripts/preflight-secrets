#!/usr/bin/env python3
"""Validate public secret-delivery inputs before Ansible contacts a host."""

import json
import os
import re
import subprocess
import stat
import sys
from pathlib import Path

import yaml

ROOT = Path(os.environ.get("BASTION_ROOT", Path(__file__).resolve().parents[1])).resolve()
REQUIRED = {
    "owner_age_recipient", "vps_age_recipient", "admin_authorized_key",
    "vps_age_identity_file", "sops_secrets_file",
}
AGE_RECIPIENT = re.compile(r"age1[023456789acdefghjklmnpqrstuvwxyz]{58}")
ED25519_KEY = re.compile(r"ssh-ed25519 [A-Za-z0-9+/=]+(?: [^\r\n]+)?$")
SOPS_FILE = re.compile(r"secrets/[A-Za-z0-9][A-Za-z0-9_.-]*\.yaml")
SECRET_NAMES = (
    "admin-password-hash", "root-password-hash", "openvpn-server-key", "wireguard-server-key",
)


def fail(message: str) -> None:
    raise SystemExit(f"preflight-secrets: {message}")


def main() -> None:
    input_path = Path(sys.argv[1]) if len(sys.argv) == 2 else ROOT / "inventory/secrets-input.json"
    try:
        values = json.loads(input_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read JSON input: {error}")
    if not isinstance(values, dict) or set(values) != REQUIRED:
        fail("input must contain exactly the required public delivery fields")
    owner = values["owner_age_recipient"]
    vps = values["vps_age_recipient"]
    if not isinstance(owner, str) or not AGE_RECIPIENT.fullmatch(owner):
        fail("owner_age_recipient is not an age public recipient")
    if not isinstance(vps, str) or not AGE_RECIPIENT.fullmatch(vps) or owner == vps:
        fail("vps_age_recipient must be an independent age public recipient")
    if not isinstance(values["admin_authorized_key"], str) or not ED25519_KEY.fullmatch(values["admin_authorized_key"]):
        fail("admin_authorized_key must be an Ed25519 public key")
    identity_value = values["vps_age_identity_file"]
    if not isinstance(identity_value, str):
        fail("vps_age_identity_file must be a string")
    identity = Path(identity_value)
    if not identity.is_absolute() or not identity.is_file():
        fail("vps_age_identity_file must be an existing absolute regular file")
    if stat.S_IMODE(identity.stat().st_mode) != 0o600:
        fail("vps_age_identity_file must have mode 0600")
    derived = subprocess.run(["age-keygen", "-y", str(identity)], text=True, capture_output=True)
    if derived.returncode != 0 or derived.stdout.strip() != vps:
        fail("vps_age_identity_file does not derive vps_age_recipient")
    ciphertext_value = values["sops_secrets_file"]
    if not isinstance(ciphertext_value, str) or not SOPS_FILE.fullmatch(ciphertext_value):
        fail("sops_secrets_file must be a direct YAML file under secrets/")
    ciphertext = ROOT / ciphertext_value
    if ciphertext.resolve().parent != (ROOT / "secrets").resolve():
        fail("sops_secrets_file must not leave secrets/")
    try:
        payload = ciphertext.read_text(encoding="utf-8")
    except OSError as error:
        fail(f"cannot read SOPS ciphertext: {error}")
    try:
        document = yaml.safe_load(payload)
    except yaml.YAMLError as error:
        fail(f"cannot parse SOPS ciphertext YAML: {error}")
    if not isinstance(document, dict):
        fail("SOPS ciphertext must be a YAML mapping")
    sops = document.get("sops")
    if not isinstance(sops, dict) or not isinstance(sops.get("age"), list):
        fail("SOPS ciphertext must contain SOPS age recipient metadata")
    recipients = set()
    for recipient in sops["age"]:
        if not isinstance(recipient, dict) or not isinstance(recipient.get("recipient"), str):
            fail("SOPS age recipient metadata is malformed")
        recipients.add(recipient["recipient"])
    if owner not in recipients or vps not in recipients:
        fail("SOPS ciphertext must contain both independent recipients")
    if any(name not in payload for name in SECRET_NAMES):
        fail("SOPS ciphertext is missing required server secret names")
    sops_environment = os.environ.copy()
    sops_environment["SOPS_AGE_KEY_FILE"] = str(identity)
    for name in SECRET_NAMES:
        try:
            decrypted = subprocess.run(
                ["sops", "--decrypt", "--extract", f'["{name}"]', str(ciphertext)],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=sops_environment,
            )
        except OSError:
            fail("cannot run local sops to validate ciphertext")
        if decrypted.returncode != 0 or not decrypted.stdout.strip():
            fail("SOPS ciphertext cannot decrypt every required server secret")


if __name__ == "__main__":
    main()
