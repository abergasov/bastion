@@ -0,0 +1,81 @@
+package internal
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func useMockTelegram(t *testing.T, handler func(http.ResponseWriter, *http.Request, int32)) *int32 {
+	t.Helper()
+	oldConf, oldClient, oldURL, oldDelay := conf, notificationClient, telegramAPIURL, notificationRetryDelay
+	t.Cleanup(func() {
+		conf, notificationClient, telegramAPIURL, notificationRetryDelay = oldConf, oldClient, oldURL, oldDelay
+	})
+	var attempts int32
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		atomic.AddInt32(&attempts, 1)
+		handler(writer, request, atomic.LoadInt32(&attempts))
+	}))
+	t.Cleanup(server.Close)
+	conf = &Config{TelegramBotToken: "test-token", TelegramNotifyChat: "test-chat"}
+	notificationClient = server.Client()
+	telegramAPIURL = server.URL + "/bot%s/sendMessage"
+	notificationRetryDelay = 0 * time.Second
+	return &attempts
+}
+
+func TestTelegramDeliverySucceedsImmediately(t *testing.T) {
+	attempts := useMockTelegram(t, func(writer http.ResponseWriter, request *http.Request, attempt int32) {
+		writer.WriteHeader(http.StatusOK)
+	})
+	sendWithRetry(func() error { return TelegramMessage("message", "html") })
+	if got := atomic.LoadInt32(attempts); got != 1 {
+		t.Fatalf("attempts = %d, want 1", got)
+	}
+}
+
+func TestTelegramDeliveryRetries(t *testing.T) {
+	attempts := useMockTelegram(t, func(writer http.ResponseWriter, request *http.Request, attempt int32) {
+		if attempt < 3 {
+			writer.WriteHeader(http.StatusBadGateway)
+			return
+		}
+		writer.WriteHeader(http.StatusOK)
+	})
+	sendWithRetry(func() error { return TelegramMessage("message", "html") })
+	if got := atomic.LoadInt32(attempts); got != 3 {
+		t.Fatalf("attempts = %d, want 3", got)
+	}
+}
+
+func TestTelegramDeliveryStopsAfterSixFailuresAndProcessesNextEvent(t *testing.T) {
+	attempts := useMockTelegram(t, func(writer http.ResponseWriter, request *http.Request, attempt int32) {
+		if attempt <= maxNotificationAttempts {
+			writer.WriteHeader(http.StatusBadGateway)
+			return
+		}
+		writer.WriteHeader(http.StatusOK)
+	})
+	if err := sendWithRetry(func() error { return TelegramMessage("lost event", "html") }); err == nil {
+		t.Fatal("sendWithRetry returned nil after exhausted delivery")
+	}
+	if got := atomic.LoadInt32(attempts); got != maxNotificationAttempts {
+		t.Fatalf("failed event attempts = %d, want %d", got, maxNotificationAttempts)
+	}
+	sendWithRetry(func() error { return TelegramMessage("next event", "html") })
+	if got := atomic.LoadInt32(attempts); got != maxNotificationAttempts+1 {
+		t.Fatalf("attempts after next event = %d, want %d", got, maxNotificationAttempts+1)
+	}
+}
+
+func TestTelegramAPIURLTemplateUsesDefaultAndOverride(t *testing.T) {
+	t.Setenv("SSH_NOTIFY_TELEGRAM_API_URL", "")
+	if got := telegramAPIURLTemplate(); got != "https://api.telegram.org/bot%s/sendMessage" {
+		t.Fatalf("default Telegram URL = %q", got)
+	}
+	t.Setenv("SSH_NOTIFY_TELEGRAM_API_URL", "http://127.0.0.1:8080/bot%s/sendMessage")
+	if got := telegramAPIURLTemplate(); got != "http://127.0.0.1:8080/bot%s/sendMessage" {
+		t.Fatalf("override Telegram URL = %q", got)
+	}
+}
