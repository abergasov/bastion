+package internal
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestReadConfUsesRuntimePath(t *testing.T) {
+	configPath := filepath.Join(t.TempDir(), "ssh-notify.conf")
+	if err := os.WriteFile(configPath, []byte("ServerName = bastion-test\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SSH_NOTIFY_CONFIG", configPath)
+	config := readConf()
+	if got := (*config)["ServerName"]; got != "bastion-test" {
+		t.Fatalf("ServerName = %q, want bastion-test", got)
+	}
+}
