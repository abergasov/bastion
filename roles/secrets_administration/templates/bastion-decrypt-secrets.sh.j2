#!/usr/bin/env bash
set -euo pipefail
umask 077
runtime_dir=/run/secrets/bastion
rm -rf "$runtime_dir"
install -d -m 0700 /run/secrets
staging_dir=$(mktemp -d /run/secrets/.bastion.XXXXXX)
trap 'rm -rf "$staging_dir"' EXIT
for name in admin-password-hash root-password-hash openvpn-server-key wireguard-server-key; do
  SOPS_AGE_KEY_FILE=/var/lib/bastion/age/identity.txt \
    /usr/local/bin/sops --decrypt --extract "[\"$name\"]" /var/lib/bastion/secrets/server.yaml > "$staging_dir/$name"
  test -s "$staging_dir/$name"
done
chown -R root:root "$staging_dir"
chmod 0700 "$staging_dir"
chmod 0600 "$staging_dir"/*
mv "$staging_dir" "$runtime_dir"
