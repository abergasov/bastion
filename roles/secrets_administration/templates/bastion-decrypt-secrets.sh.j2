#!/usr/bin/env bash
set -euo pipefail
umask 077
persistent_dir=/var/lib/bastion/secrets
runtime_parent=/run/secrets
runtime_link=$runtime_parent/bastion
test -d "$persistent_dir"

test -s "$persistent_dir/admin-password-hash"
test -s "$persistent_dir/root-password-hash"
test -s "$persistent_dir/ssh-notify.conf"
grep -Eq '^\$6\$' "$persistent_dir/admin-password-hash"
grep -Eq '^\$6\$' "$persistent_dir/root-password-hash"
grep -Fqx 'SSHLogFile = /var/log/auth.log' "$persistent_dir/ssh-notify.conf"
grep -Fqx 'ServerName = bastion' "$persistent_dir/ssh-notify.conf"
grep -Eq '^TelegramBotToken = .+' "$persistent_dir/ssh-notify.conf"
grep -Eq '^TelegramNotifyChat = .+' "$persistent_dir/ssh-notify.conf"

vpn_keys=0
if test -e "$persistent_dir/openvpn-server-key" || test -e "$persistent_dir/wireguard-server-key"; then
  test -s "$persistent_dir/openvpn-server-key"
  test -s "$persistent_dir/wireguard-server-key"
  grep -Eq '^[A-Za-z0-9+/]{43}=$' "$persistent_dir/wireguard-server-key"
  openssl pkey -in "$persistent_dir/openvpn-server-key" -noout >/dev/null 2>&1
  vpn_keys=1
fi

legacy_ca_key=0
if test -e "$persistent_dir/openvpn-ca-key"; then
  test -s "$persistent_dir/openvpn-ca-key"
  openssl pkey -in "$persistent_dir/openvpn-ca-key" -noout >/dev/null 2>&1
  legacy_ca_key=1
fi

install -d -m 0700 "$runtime_parent"
staging_dir=$(mktemp -d "$runtime_parent/.bastion.XXXXXX")
trap 'rm -rf "$staging_dir" "$runtime_parent/.bastion-link.XXXXXX"' EXIT
for name in admin-password-hash root-password-hash ssh-notify.conf; do
  install -m 0600 -o root -g root "$persistent_dir/$name" "$staging_dir/$name"
done
if test "$vpn_keys" = 1; then
  for name in openvpn-server-key wireguard-server-key; do
    install -m 0600 -o root -g root "$persistent_dir/$name" "$staging_dir/$name"
  done
fi
if test "$legacy_ca_key" = 1; then
  install -m 0600 -o root -g root "$persistent_dir/openvpn-ca-key" "$staging_dir/openvpn-ca-key"
fi

case "$(readlink "$runtime_link" 2>/dev/null || true)" in
  .bastion.*) previous_target=$(readlink "$runtime_link") ;;
  *) previous_target='' ;;
esac
if test -e "$runtime_link" && ! test -L "$runtime_link"; then
  rm -rf "$runtime_link"
fi
link_path=$(mktemp -u "$runtime_parent/.bastion-link.XXXXXX")
ln -s "$(basename "$staging_dir")" "$link_path"
mv -Tf "$link_path" "$runtime_link"
if test -n "$previous_target"; then
  rm -rf "$runtime_parent/$previous_target"
fi
trap - EXIT
