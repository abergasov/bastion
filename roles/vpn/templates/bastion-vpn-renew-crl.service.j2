[Unit]
Description=Renew Bastion OpenVPN revocation list
Requires=bastion-secrets.service
After=bastion-secrets.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/bastion-vpn-renew-crl
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/bastion/vpn /run/bastion-vpn /run/lock
