#!/usr/bin/env bash
set -euo pipefail

archive=$1
state_root=/var/lib/bastion/vpn
releases=$state_root/releases
current=$state_root/current
lock=/run/lock/bastion-vpn-state.lock

case "$archive" in /home/admin/.bastion-vpn-release-????????????????????????????????.tar) ;; *)
  echo 'publisher refused unsafe archive path' >&2; exit 1 ;;
esac
test -f "$archive"
install -d -m 0700 "$releases" /run/lock

# Verification owns a shared lock, so snapshot before taking the writer lock.
old_state=
if test -L "$current"; then old_state=$(/usr/local/libexec/bastion-vpn-verify-state 2>/dev/null || true); fi
exec 9>"$lock"
flock -x 9
locked_state=$(realpath -e "$current" 2>/dev/null || true)
if test -n "$locked_state" || test -n "$old_state"; then
  test -n "$old_state" && test "$locked_state" = "$old_state" || {
    echo 'publisher state changed during validation; retry' >&2; exit 1;
  }
fi
staging=$(mktemp -d "$releases/.incoming.XXXXXX")
trap 'rm -rf "$staging" "$archive"' EXIT
expected=$'release/\nrelease/READY\nrelease/manifest.sha256\nrelease/openvpn/\nrelease/openvpn/ca.crt\nrelease/openvpn/crl.pem\nrelease/openvpn/index.txt\nrelease/openvpn/metadata.json\nrelease/openvpn/server.crt\nrelease/wireguard/\nrelease/wireguard/peers'
test "$(tar -tf "$archive" | LC_ALL=C sort)" = "$expected" || {
  echo 'publisher refused unsupported release archive' >&2; exit 1;
}
tar --extract --file "$archive" --directory "$staging" --no-same-owner --no-same-permissions
find -P "$staging/release" -xdev -type l -print -quit | grep -q . && {
  echo 'publisher refused symlink in release' >&2; exit 1;
}
read -r incoming_revision incoming_sequence < <(python3 - "$staging/release/openvpn/metadata.json" <<'PY'
import json
import sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
if (set(value) != {"version", "membership_revision", "crl_sequence", "openvpn_clients", "revocations"}
        or value["version"] != 2 or not isinstance(value["membership_revision"], int)
        or value["membership_revision"] < 1 or not isinstance(value["crl_sequence"], int)
        or value["crl_sequence"] < 1):
    raise SystemExit("invalid public membership metadata")
print(value["membership_revision"], value["crl_sequence"])
PY
)
current_revision=0
if test -n "$old_state"; then
  current_revision=$(python3 - "$old_state/openvpn/metadata.json" <<'PY'
import json
import sys
try:
    value = json.load(open(sys.argv[1], encoding="utf-8"))
    print(value["membership_revision"] if value.get("version") == 2 else 0)
except (OSError, ValueError, KeyError):
    print(0)
PY
)
fi
test "$incoming_revision" -ge "$current_revision" || {
  echo 'publisher refused stale membership revision' >&2; exit 1;
}
if test "$incoming_revision" -eq "$current_revision" && test -n "$old_state"; then
  # Equal membership cannot replace a valid server-renewed CRL with controller bytes.
  cmp -s "$old_state/openvpn/ca.crt" "$staging/release/openvpn/ca.crt" &&
    cmp -s "$old_state/openvpn/index.txt" "$staging/release/openvpn/index.txt" || {
      echo 'publisher refused conflicting equal membership revision' >&2; exit 1;
    }
  cp "$old_state/openvpn/crl.pem" "$staging/release/openvpn/crl.pem"
  cp "$old_state/openvpn/metadata.json" "$staging/release/openvpn/metadata.json"
  (cd "$staging/release" && sha256sum openvpn/ca.crt openvpn/crl.pem openvpn/index.txt openvpn/metadata.json openvpn/server.crt wireguard/peers > manifest.sha256)
fi
release="$releases/release-$(date -u +%Y%m%dT%H%M%SZ)-$(od -An -N4 -tx4 /dev/urandom | tr -d ' ')"
mv "$staging/release" "$release"
chown -R root:root "$release"
find -P "$release" -type d -exec chmod 0700 {} +
find -P "$release" -type f -exec chmod 0600 {} +
ln -s "releases/$(basename "$release")" "$state_root/.current.next"
mv -Tf "$state_root/.current.next" "$current"
flock -u 9

if test "$incoming_revision" -gt "$current_revision" && test -r /run/secrets/bastion/openvpn-ca-key; then
  # Reconcile from the newly accepted public input; it never restores the old release.
  /usr/local/libexec/bastion-vpn-renew-crl --reconcile
fi
/usr/local/libexec/bastion-vpn-apply-state
state=$(/usr/local/libexec/bastion-vpn-verify-state)
test "$(realpath -e "$current")" = "$state"
test -r /run/bastion-vpn/active/openvpn/crl.pem
systemctl is-active --quiet openvpn-server@bastion.service
expected=$(awk '{print $1}' "$state/wireguard/peers" | LC_ALL=C sort)
actual=$(wg show wg-bastion peers | LC_ALL=C sort)
test "$actual" = "$expected" || {
  echo 'publisher WireGuard live peers differ from the release' >&2; exit 1;
}
