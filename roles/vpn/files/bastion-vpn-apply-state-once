#!/usr/bin/env bash
set -euo pipefail

runtime_root=/run/bastion-vpn
active=$runtime_root/active
state_root=/var/lib/bastion/vpn
lock=/run/lock/bastion-vpn-state.lock

fail_closed() {
  trap - ERR
  systemctl stop openvpn-server@bastion.service || true
  ip link delete wg-bastion 2>/dev/null || true
  rm -f "$active" "$active.next"
  exit 1
}
trap fail_closed ERR

state=$(/usr/local/libexec/bastion-vpn-verify-state)
configure_wireguard=true
if test -L "$active"; then
  previous=$(realpath -e "$active" || true)
  if test -n "$previous" && cmp -s "$previous/wireguard/peers" "$state/wireguard/peers"; then
    configure_wireguard=false
  fi
fi
exec 9>"$lock"
flock -x 9
test "$(realpath -e /var/lib/bastion/vpn/current)" = "$state"
install -d -m 0700 "$runtime_root"
rm -f "$active.next"
ln -s "$state" "$active.next"
mv -Tf "$active.next" "$active"
test "$(realpath -e "$active")" = "$state"
flock -u 9
if "$configure_wireguard"; then
  /usr/local/libexec/bastion-vpn-configure-wireguard "$state"
fi
systemctl restart openvpn-server@bastion.service
next_update=$(openssl crl -in "$state/openvpn/crl.pem" -noout -nextupdate | sed -n 's/^nextUpdate=//p')
next_epoch=$(date -u -d "$next_update" +%s)
python3 - "$state_root/crl-status.json" "$state/openvpn/metadata.json" "$next_epoch" <<'PY'
import json
import os
import sys
import time
from pathlib import Path

status, metadata = map(Path, sys.argv[1:3])
next_update = int(sys.argv[3])
try:
    value = json.loads(status.read_text())
    active = json.loads(metadata.read_text())
except (OSError, ValueError, KeyError, TypeError):
    value = {}
    active = json.loads(metadata.read_text())
value.update({
    "membership_revision": active["membership_revision"],
    "crl_sequence": active["crl_sequence"],
    "activation_pending": False,
    "next_update": next_update,
    "result": "activated",
    "reason": "activated",
    "remaining_validity_seconds": max(0, next_update - int(time.time())),
})
value.setdefault("notification_failed", False)
temporary = status.with_name(status.name + ".next")
temporary.write_text(json.dumps(value, sort_keys=True) + "\n")
os.chmod(temporary, 0o600)
os.replace(temporary, status)
PY
trap - ERR
