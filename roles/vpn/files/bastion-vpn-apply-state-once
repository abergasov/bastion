#!/usr/bin/env bash
set -euo pipefail

runtime_root=/run/bastion-vpn
active=$runtime_root/active
state_root=/var/lib/bastion/vpn
lock=/run/lock/bastion-vpn-state.lock

fail_closed() {
  trap - ERR
  systemctl stop openvpn-server@bastion.service || true
  ip link delete wg-bastion 2>/dev/null || true
  rm -f "$active" "$active.next"
  exit 1
}
trap fail_closed ERR

state=$(/usr/local/libexec/bastion-vpn-verify-state)
configure_wireguard=true
if test -L "$active"; then
  previous=$(realpath -e "$active" || true)
  if test -n "$previous" && cmp -s "$previous/wireguard/peers" "$state/wireguard/peers"; then
    configure_wireguard=false
  fi
fi
exec 9>"$lock"
flock -x 9
test "$(realpath -e /var/lib/bastion/vpn/current)" = "$state"
install -d -m 0700 "$runtime_root"
rm -f "$active.next"
ln -s "$state" "$active.next"
mv -Tf "$active.next" "$active"
test "$(realpath -e "$active")" = "$state"
flock -u 9
if "$configure_wireguard"; then
  /usr/local/libexec/bastion-vpn-configure-wireguard "$state"
fi
systemctl restart openvpn-server@bastion.service
trap - ERR
