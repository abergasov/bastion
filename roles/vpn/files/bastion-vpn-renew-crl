#!/usr/bin/env bash
set -euo pipefail

# This is deliberately a small, root-only signer.  Its only private input is the
# runtime CA key; membership input always comes from a verified public release.
state_root=/var/lib/bastion/vpn
releases=$state_root/releases
current=$state_root/current
status=$state_root/crl-status.json
key=/run/secrets/bastion/openvpn-ca-key
lock=/run/lock/bastion-vpn-state.lock
window=$((7 * 24 * 60 * 60))
activate=false
reconcile=false

case "${1:-}" in
  '') ;;
  --activate) activate=true ;;
  --reconcile) reconcile=true ;;
  --reconcile-and-activate) reconcile=true; activate=true ;;
  *) echo 'usage: bastion-vpn-renew-crl [--activate|--reconcile|--reconcile-and-activate]' >&2; exit 2 ;;
esac

write_status() {
  local revision=$1 sequence=$2 pending=$3 next=$4 result=$5
  python3 - "$status" "$revision" "$sequence" "$pending" "$next" "$result" <<'PY'
import json
import os
import sys
import time
from pathlib import Path

path, revision, sequence, pending, next_update, result = sys.argv[1:]
temporary = Path(path + ".next")
temporary.write_text(json.dumps({
    "membership_revision": int(revision), "crl_sequence": int(sequence),
    "activation_pending": pending == "true", "next_update": int(next_update), "result": result,
    "reason": result, "remaining_validity_seconds": max(0, int(next_update) - int(time.time())),
    "notification_failed": False,
}, sort_keys=True) + "\n")
os.chmod(temporary, 0o600)
os.replace(temporary, path)
PY
}

record_failure() {
  local code=$?
  python3 - "$status" <<'PY' || true
import json
import os
import sys
import time
from pathlib import Path

path = Path(sys.argv[1])
try:
    value = json.loads(path.read_text())
except (OSError, ValueError):
    value = {"membership_revision": 0, "crl_sequence": 0, "activation_pending": False, "next_update": 0}
value["result"] = "failed"
value["reason"] = "renewal failed; inspect systemd logs"
next_update = value.get("next_update", 0)
value["remaining_validity_seconds"] = max(0, next_update - int(time.time())) if isinstance(next_update, int) and next_update else None
value["notification_failed"] = False
temporary = path.with_name(path.name + ".next")
temporary.write_text(json.dumps(value, sort_keys=True) + "\n")
os.chmod(temporary, 0o600)
os.replace(temporary, path)
PY
  if test -x /usr/local/libexec/ssh_notify; then
    if ! SSH_NOTIFY_CONFIG=/run/secrets/bastion/ssh-notify.conf /usr/local/libexec/ssh_notify message 'Bastion CRL renewal failed; inspect crl-status.json and systemd logs.'; then
      python3 - "$status" <<'PY' || true
import json, os, sys
from pathlib import Path
path = Path(sys.argv[1])
try:
    value = json.loads(path.read_text())
    value["notification_failed"] = True
    temporary = path.with_name(path.name + ".next")
    temporary.write_text(json.dumps(value, sort_keys=True) + "\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
except (OSError, ValueError):
    pass
PY
    fi
  fi
  exit "$code"
}
trap record_failure ERR

read_status() {
  python3 - "$status" <<'PY'
import json
import sys
try:
    value = json.load(open(sys.argv[1], encoding="utf-8"))
    if not {"membership_revision", "crl_sequence", "activation_pending", "next_update", "result"} <= set(value):
        raise ValueError
    print(value["membership_revision"], value["crl_sequence"], str(value["activation_pending"]).lower())
except (OSError, ValueError, TypeError):
    print("0 0 false")
PY
}

read_metadata() {
  python3 - "$1/openvpn/metadata.json" <<'PY'
import json
import sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
print(value["membership_revision"], value["crl_sequence"])
PY
}

next_update() {
  local value
  value=$(openssl crl -in "$1" -noout -nextupdate | sed -n 's/^nextUpdate=//p')
  date -u -d "$value" +%s
}

validate_key() {
  test -f "$key" && test ! -L "$key" || { echo 'CRL renewal CA key is unavailable' >&2; return 1; }
  test "$(stat -c '%U:%G:%a' "$key")" = root:root:600 || { echo 'CRL renewal CA key must be root-owned mode 0600' >&2; return 1; }
  openssl pkey -in "$key" -noout >/dev/null
  test "$(openssl pkey -in "$key" -pubout)" = "$(openssl x509 -in "$1/openvpn/ca.crt" -pubkey -noout)" || {
    echo 'CRL renewal CA key does not match public CA' >&2
    return 1
  }
}

install -d -m 0700 "$releases"
# Verification takes its own shared lock, so do it before acquiring the writer lock.
verified=$(/usr/local/libexec/bastion-vpn-verify-state --allow-expired)
exec 9>"$lock"
flock -x 9
test "$(realpath -e "$current")" = "$verified" || { echo 'VPN state changed during CRL renewal; retry' >&2; exit 1; }
state=$verified
read -r revision sequence < <(read_metadata "$state")
read -r saved_revision saved_sequence pending < <(read_status)
expiry=$(next_update "$state/openvpn/crl.pem")
now=$(date -u +%s)
if test "$saved_revision" -ne "$revision" || test "$saved_sequence" -ne "$sequence"; then
  # A lost/stale status is bookkeeping, not a reason to replace a still-valid CRL.
  write_status "$revision" "$sequence" false "$expiry" verified
  saved_revision=$revision; saved_sequence=$sequence; pending=false
fi

generate=false
if "$reconcile" || test "$expiry" -le $((now + window)); then
  generate=true
fi

if "$generate"; then
  validate_key "$state"
  work=$(mktemp -d "$state_root/.crl-renew.XXXXXX")
  trap 'rm -rf "$work"' EXIT
  cp "$state/openvpn/ca.crt" "$work/ca.crt"
  cp "$state/openvpn/index.txt" "$work/index.txt"
  mkdir "$work/newcerts"
  next_sequence=$((sequence + 1))
  if test "$saved_sequence" -ge "$next_sequence"; then next_sequence=$((saved_sequence + 1)); fi
  printf '%X\n' "$next_sequence" > "$work/crlnumber"
  printf '1000\n' > "$work/serial"
  cat > "$work/openssl.cnf" <<EOF
[ ca ]
default_ca = CA_default
[ CA_default ]
dir = $work
database = \$dir/index.txt
new_certs_dir = \$dir/newcerts
certificate = \$dir/ca.crt
private_key = $key
serial = \$dir/serial
crlnumber = \$dir/crlnumber
default_md = sha256
default_crl_days = 30
policy = policy_any
[ policy_any ]
commonName = supplied
EOF
  openssl ca -batch -config "$work/openssl.cnf" -gencrl -out "$work/crl.pem" >/dev/null
  openssl crl -in "$work/crl.pem" -noout -verify -CAfile "$work/ca.crt" >/dev/null
  renewed_expiry=$(next_update "$work/crl.pem")
  test "$renewed_expiry" -gt $((now + window)) || { echo 'renewed CRL is too close to expiry' >&2; exit 1; }
  renewed_sequence=$(openssl crl -in "$work/crl.pem" -noout -crlnumber | sed 's/.*=0x//' )
  test "$((16#$renewed_sequence))" -eq "$next_sequence" || { echo 'renewed CRL sequence is invalid' >&2; exit 1; }
  next="$releases/release-$(date -u +%Y%m%dT%H%M%SZ)-crl-$(od -An -N4 -tx4 /dev/urandom | tr -d ' ')"
  cp -a "$state" "$next"
  cp "$work/crl.pem" "$next/openvpn/crl.pem"
  python3 - "$next/openvpn/metadata.json" "$next_sequence" <<'PY'
import json
import os
import sys
from pathlib import Path

path = Path(sys.argv[1])
value = json.loads(path.read_text())
value["crl_sequence"] = int(sys.argv[2])
temporary = path.with_name(path.name + ".next")
temporary.write_text(json.dumps(value, sort_keys=True) + "\n")
os.chmod(temporary, 0o600)
os.replace(temporary, path)
PY
  (cd "$next" && sha256sum openvpn/ca.crt openvpn/crl.pem openvpn/index.txt openvpn/metadata.json openvpn/server.crt wireguard/peers > manifest.sha256)
  chown -R root:root "$next"
  find -P "$next" -type d -exec chmod 0700 {} +
  find -P "$next" -type f -exec chmod 0600 {} +
  ln -s "releases/$(basename "$next")" "$state_root/.current.next"
  mv -Tf "$state_root/.current.next" "$current"
  write_status "$revision" "$next_sequence" true "$renewed_expiry" signed
  pending=true
fi
flock -u 9

if "$activate" && { "$generate" || test "$pending" = true; }; then
  systemctl restart bastion-vpn-apply.service
  activated=$(/usr/local/libexec/bastion-vpn-verify-state)
  test "$(realpath -e "$current")" = "$activated"
  systemctl is-active --quiet openvpn-server@bastion.service
  read -r activated_revision activated_sequence < <(read_metadata "$activated")
  activated_expiry=$(next_update "$activated/openvpn/crl.pem")
  write_status "$activated_revision" "$activated_sequence" false "$activated_expiry" activated
fi
